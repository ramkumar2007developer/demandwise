# Copy this file to .env and adjust values for local development.
# Do not commit a real .env file.

APP_NAME=DemandWise
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Comma-separated browser origins allowed during local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:3000

# Approximate Coimbatore bounding box (not an official municipal boundary).
COIMBATORE_MIN_LAT=10.85
COIMBATORE_MAX_LAT=11.20
COIMBATORE_MIN_LNG=76.80
COIMBATORE_MAX_LNG=77.20

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ta
ALLOWED_BUSINESS_TYPES=cafe,hotel,retail

# Budget limits in INR for future business-analysis requests.
MIN_BUDGET_INR=1
MAX_BUDGET_INR=50000000

# Phase 2 ML artifacts. Predictions from this model are synthetic-demo only.
ML_DATASET_PATH=data/synthetic_coimbatore_demand_demo.csv
ML_ARTIFACT_PATH=artifacts/demand_pipeline.joblib
ML_METADATA_PATH=artifacts/training_metadata.json

# Phase 3 External Competitor Search & Retrieval (OpenStreetMap Overpass API)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
COMPETITOR_SEARCH_RADIUS_METERS=2000
COMPETITOR_SEARCH_TIMEOUT_SECONDS=10.0
COMPETITOR_SEARCH_MAX_RESULTS=50
COMPETITOR_USER_AGENT=DemandWise/1.0.0 (student project; https://github.com/demandwise)

# Phase 4 Multilingual LLM Explanations (Groq / OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.3
